<%- include("partials/navbar.ejs") %>

<% if (yarns.length === 0) { %>
  <p>No results found</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>name</th><th>brand</th><th>color</th><th>shade</th><th>yarn weight</th>
        <th>dye lot</th><th>qty</th><th>material(s)</th><th>net weight (g per ball)</th><th>length (m)</th>
        <th>recommended needle size (mm)</th><th>recommended hook size (mm)</th><th></th><th></th>
      </tr>
    </thead>
    <tbody>
      <% yarns.forEach((y) => { %>
        <tr>
          <td><%= y.name %></td>
          <td><%= y.brand %></td>
          <td><%= y.color %></td>
          <td><%= y.shade_code %></td>
          <td><%= y.weight %></td>
          <td><%= y.dye_lot || "N/A" %></td>
          <td><%= y.quantity %></td>
          <td><%= (y.materials || []).join(", ") %></td>
          <td><%= y.net_weight %></td>
          <td><%= y.length_meters %></td>
          <td><%= y.rec_needle %></td>
          <td><%= y.rec_hook %></td>
          <td><form method="GET" action="/yarns/<%= y.id %>/edit">
            <button type="submit">Edit</button>
          </form></td>
          <td><form method="POST" action="/yarns/<%= y.id %>/delete">
            <button type="submit">Delete</button>
          </form></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <td>
  <form method="GET" action="/yarns/add">
    <button type="submit">Add yarn</button>
  </form></td>
<% } %>