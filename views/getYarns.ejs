<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <script src="https://kit.fontawesome.com/53d5910f58.js" crossorigin="anonymous"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@100;200;300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Rakkas&display=swap" rel="stylesheet">
  <title>Yarns</title>
</head>
<body>
  <%- include("partials/navbar.ejs") %>
  <div class=" yarns container">

    <% if (yarns.length === 0) { %>
      <p>No results found</p>
    <% } else { %>
      <table class="yarns">
        <thead>
          <tr>
            <th>Name</th><th>Brand</th><th>Color</th><th>Shade</th><th>Yarn weight</th>
            <th>Dye lot</th><th>Qty</th><th>Material(s)</th><th>Weight per ball<br>(g)</th>
            <th>Length<br>(m)</th><th>Needle size<br>(mm)</th><th>Hook size<br>(mm)</th><th>
            </th><th></th>
          </tr>
        </thead>
        <tbody>
          <% yarns.forEach((y) => { %>
            <tr>
              <td><%= y.name %></td>
              <td><%= y.brand %></td>
              <td><%= y.color %></td>
              <td><%= y.shade_code %></td>
              <td><%= toSentenceCase(y.weight) %></td>
              <td><%= y.dye_lot || "N/A" %></td>
              <td><%= y.quantity %></td>
              <td><%= toSentenceCase((y.materials || []).join(", ")) %></td>
              <td><%= y.net_weight %></td>
              <td><%= y.length_meters %></td>
              <td><%= y.rec_needle %></td>
              <td><%= y.rec_hook %></td>
              <td><form method="GET" action="/yarns/<%= y.id %>/edit">
                <button type="submit" aria-label="Edit"><i class="fa-regular fa-pen-to-square"></i></button>
              </form></td>
              <td><form method="POST" action="/yarns/<%= y.id %>/delete">
                <button type="submit" aria-label="Delete"><i class="fa-regular fa-trash-can"></i></button>
              </form></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <td>
      <form method="GET" action="/yarns/add">
        <button type="submit">+ Add yarn</button>
      </form></td>
    <% } %>
  </div>

</body>
</html>

