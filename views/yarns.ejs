<table>
  <thead>
    <tr>
      <th>Name</th><th>Brand</th><th>Color</th><th>Shade</th><th>Yarn weight</th>
      <th>Dye lot</th><th>Qty</th><th>Material(s)</th><th>Net weight</th><th>Length (m)</th>
      <th>Recommended needle size (mm)</th><th>Recommended hook size (mm)</th><th></th>
    </tr>
  </thead>
  <tbody>
    <% yarns.forEach((y) => { %>
      <tr>
        <td><%= y.name %></td>
        <td><%= y.brand %></td>
        <td><%= y.color %></td>
        <td><%= y.shade_code %></td>
        <td><%= y.weight %></td>
        <td><%= y.dye_lot || "N/A" %></td>
        <td><%= y.quantity %></td>
        <td><%= (y.materials || []).join(", ") %></td>
        <td><%= y.net_weight %></td>
        <td><%= y.length_meters %></td>
        <td><%= y.rec_needle %></td>
        <td><%= y.rec_hook %></td>
        <td><a href="/yarns/<%= y.id %>/edit">Edit</a></td>
      </tr>
    <% }); %>
  </tbody>
</table>