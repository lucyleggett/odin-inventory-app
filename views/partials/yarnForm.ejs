<form action="<%= action %>" method="POST" id="yarns-form" class="pw-verifiable-form" <%= action.endsWith("/edit") ? "data-confirm-password" : "" %>>
  <div class="couple">
    <label for="weight">Weight</label>
    <select name="weight" id="weight" required>
      <% categories.forEach((c) => { %>
      <option value="<%= c.weight %>" <%= yarn.weight === c.weight ? 'selected' : '' %>>
        <%= toSentenceCase(c.weight) %> (<%= formatRange(c.ply_lower, c.ply_upper) %> ply)
      </option>
      <% }) %>
    </select>
  </div>

  <div class="couple">
    <label for="name">Name</label>
    <input name="name" type="text" id="name" value="<%= yarn.name || "" %>" required />
  </div>

  <div class="couple">
    <label for="brand">Brand</label>
    <input name="brand" type="text" id="brand" value="<%= yarn.brand || "" %>" />
  </div>

  <div class="couple">
    <label for="color">Colour</label>
    <input name="color" type="text" id="color" value="<%= yarn.color || "" %>" />
  </div>

  <div class="couple">
    <label for="shade_code">Shade code</label>
    <input name="shade_code" type="number" id="shade_code" value="<%= yarn.shade_code || "" %>" />
  </div>

  <div class="couple">
    <label for="dye_lot">Dye lot</label>
    <input name="dye_lot" type="number" id="dye_lot" value="<%= yarn.dye_lot || "" %>" />
  </div>

  <div class="couple">
    <label for="quantity">Quantity (# of balls)</label>
    <input name="quantity" type="number" id="quantity" value="<%= yarn.quantity || "" %>" />
  </div>

  <div class="couple">
    <label for="materials">Material(s)</label>
    <input name="materials" type="text" id="materials" value="<%= Array.isArray(yarn.materials) ? yarn.materials.join(', ') : (yarn.materials || '') %>" />
  </div>

  <div class="couple">
    <label for="net_weight">Net weight (g per ball)</label>
    <input name="net_weight" type="number" id="net_weight" value="<%= yarn.net_weight || "" %>" />
  </div>

  <div class="couple">
    <label for="length_meters">Length (m)</label>
    <input name="length_meters" type="number" id="length_meters" value="<%= yarn.length_meters || "" %>" />
  </div>

  <div class="couple">
    <label for="rec_needle">Recommended needles (mm)</label>
    <input name="rec_needle" type="number" id="rec_needle" value="<%= yarn.rec_needle || "" %>" />
  </div>

  <div class="couple">
    <label for="rec_hook">Recommended hook (mm)</label>
    <input name="rec_hook" type="number" id="rec_hook" value="<%= yarn.rec_hook || "" %>" />
  </div>

  <button type="submit"><%= submitLabel %></button>
</form>
<%- include("partials/passwordModal.ejs") %>