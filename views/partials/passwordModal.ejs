<dialog id="password-modal">
  <form id="password-form">
    <h3>Confirm password</h3>
    <p>Please enter the password to proceed with this change.</p>
    <div class="couple">
      <label for="modal-password">Password</label>
      <input type="password" id="modal-password" name="password" autocomplete="off" required>
    </div>
    <p id="password-error" role="alert" hidden></p>
    <div class="buttons">
      <button type="submit" id="password-confirm">Confirm</button>
      <button type="button" id="password-cancel">Cancel</button>
    </div>
  </form>
</dialog>
<script src="/passwordModal.js"></script>