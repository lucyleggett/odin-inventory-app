<form action="/categories/<%= category.id %>/edit" method="POST">
  <div class="couple">
    <label for="weight">weight</label>
    <input
      name="weight"
      type="text"
      id="weight"
      value="<%= category.weight %>"
    />
  </div>

  <div class="couple">
    <label for="alt_names">alternative names</label>
    <input
      name="alt_names"
      type="text"
      id="alt_names"
      value="<%= Array.isArray(category.alt_names) ? category.alt_names.join(', ') : (category.alt_names || '') %>"
    />
  </div>

  <fieldset class="couple">
    <legend for="ply">ply</legend>

    <label for="ply_lower">lower bound</label>
    <input
      name="ply_lower"
      type="number"
      id="ply_lower"
      value="<%= category.ply_lower %>"
      required
    />

    <label for="ply_upper">upper bound</label>
    <input
      name="ply_upper"
      type="number"
      id="ply_upper"
      value="<%= category.ply_upper %>"
    />
  </fieldset>

  <fieldset class="couple">
    <legend for="needle_size">needle size (mm)</legend>

    <label for="needle_lower">lower bound</label>
    <input
      name="needle_lower"
      type="number"
      id="needle_lower"
      value="<%= category.needle_lower %>"
    />

    <label for="needle_upper">upper bound</label>
    <input
      name="needle_upper"
      type="number"
      id="needle_upper"
      value="<%= category.needle_upper %>"
    />
  </fieldset>

  <fieldset class="couple">
    <legend for="hook_size">hook size (mm)</legend>

    <label for="hook_lower">lower bound</label>
    <input
      name="hook_lower"
      type="number"
      id="hook_lower"
      value="<%= category.hook_lower %>"
    />

    <label for="hook_upper">upper bound</label>
    <input
      name="hook_upper"
      type="number"
      id="hook_upper"
      value="<%= category.hook_upper %>"
    />
  </fieldset>

  <fieldset class="couple">
    <legend for="gauge">gauge (# stitches over 10cm)</legend>

    <label for="gauge_lower">lower bound</label>
    <input
      name="gauge_lower"
      type="number"
      id="gauge_lower"
      value="<%= category.gauge_lower %>"
    />

    <label for="gauge_upper">upper bound</label>
    <input
      name="gauge_upper"
      type="number"
      id="gauge_upper"
      value="<%= category.gauge_upper %>"
    />
  </fieldset>

  <button type="submit">Submit</button>
</form>
