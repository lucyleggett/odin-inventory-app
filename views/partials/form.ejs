<form action="/yarns/<%= yarn.id %>/edit" method="POST">
  <div class="couple">
    <label for="yarn_id" class="sr-only">id</label>
    <input
      name="yarn_id"
      type="number"
      id="yarn_id"
      value="<%= yarn.id %>"
      readonly
    />
  </div>

  <div class="couple">
    <label for="weight" class="sr-only">weight</label>
    <select name="weight" id="weight" selected="<%= yarn.weight %>" required>
      <option value="lace">lace (1-2 ply)</option>
      <option value="fingering">fingering (4 ply)</option>
      <option value="sport">sport (5 ply)</option>
      <option value="doubleKnit">double knit (8 ply)</option>
      <option value="aran">aran (10 ply)</option>
      <option value="chunky">chunky (12-14 ply)</option>
      <option value="roving">roving (16 ply)</option>
      <option value="jumbo">jumbo (20+ ply)</option>
    </select>
  </div>

  <div class="couple">
    <label for="name" class="sr-only">name</label>
    <input
      name="name"
      type="text"
      id="name"
      value="<%= yarn.name %>"
      required
    />
  </div>

  <div class="couple">
    <label for="brand" class="sr-only">brand</label>
    <input name="brand" type="text" id="brand" value="<%= yarn.brand %>" />
  </div>

  <div class="couple">
    <label for="color" class="sr-only">color</label>
    <input name="color" type="text" id="color" value="<%= yarn.color %>" />
  </div>

  <div class="couple">
    <label for="shade_code" class="sr-only">shade code</label>
    <input
      name="shade_code"
      type="number"
      id="shade_code"
      value="<%= yarn.shade_code %>"
    />
  </div>

  <div class="couple">
    <label for="dye_lot" class="sr-only">dye lot</label>
    <input
      name="dye_lot"
      type="number"
      id="dye_lot"
      value="<%= yarn.dye_lot %>"
    />
  </div>

  <div class="couple">
    <label for="quantity" class="sr-only">quantity (# of balls)</label>
    <input
      name="quantity"
      type="number"
      id="quantity"
      value="<%= yarn.quantity %>"
    />
  </div>

  <div class="couple">
    <label for="materials" class="sr-only">materials</label>
    <input
      name="materials"
      type="text"
      id="materials"
      value="<%= Array.isArray(yarn.materials) ? yarn.materials.join(', ') : (yarn.materials || '') %>"
    />
  </div>

  <div class="couple">
    <label for="net_weight" class="sr-only">net weight (g per ball)</label>
    <input
      name="net_weight"
      type="number"
      id="net_weight"
      value="<%= yarn.net_weight %>"
    />
  </div>

  <div class="couple">
    <label for="length_meters" class="sr-only">length (metres)</label>
    <input
      name="length_meters"
      type="number"
      id="length_meters"
      value="<%= yarn.length_meters %>"
    />
  </div>

  <div class="couple">
    <label for="rec_needle" class="sr-only">recommended needles (mm)</label>
    <input
      name="rec_needle"
      type="number"
      id="rec_needle"
      value="<%= yarn.rec_needle %>"
    />
  </div>

  <div class="couple">
    <label for="rec_hook" class="sr-only">recommended hook (mm)</label>
    <input
      name="rec_hook"
      type="number"
      id="rec_hook"
      value="<%= yarn.rec_hook %>"
    />
  </div>

  <button type="submit">Submit</button>
</form>
